# ─── Data Dictionary Agent – Environment Variables ───
# Copy this file to .env and fill in the values

# ── AWS Bedrock AI (required for AI features) ──
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0:48k
BEDROCK_REGION=ap-south-1

# ── API Security ──
# API key clients must send in the X-API-Key header
DD_API_KEY=your-secure-api-key-here

# ── Connection Pool ──
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Extraction ──
TABLE_BATCH_SIZE=200
SAMPLE_ROW_LIMIT=10000

# ── AWS Credentials ──
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
